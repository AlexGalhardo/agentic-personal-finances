set -e

# A compiled binary (bun build --compile, ~90MB) was committed by accident
# more than once — block it here instead of trusting .gitignore alone.
staged_exes=$(git diff --cached --name-only --diff-filter=ACM | grep -i '\.exe$' || true)
if [ -n "$staged_exes" ]; then
	echo "Commit blocked: staged .exe file(s) must never be committed:" >&2
	echo "$staged_exes" >&2
	exit 1
fi

# Real bank statements have leaked before (see docs/security.md).
staged_csvs=$(git diff --cached --name-only --diff-filter=ACM | grep -i '\.csv$' || true)
if [ -n "$staged_csvs" ]; then
	echo "Commit blocked: staged .csv file(s) may contain real financial data:" >&2
	echo "$staged_csvs" >&2
	exit 1
fi

if git diff --cached --name-only | grep -qx "bun.lock"; then
	lockfile_version=$(grep -m1 '"lockfileVersion"' bun.lock | grep -o '[0-9]\+')
	if [ "$lockfile_version" != "1" ]; then
		echo "bun.lock has lockfileVersion $lockfile_version; this repo pins Bun 1.4.4 and expects lockfileVersion 1." >&2
		echo "Regenerate with: bun@1.4.4 install (see packageManager in package.json)" >&2
		exit 1
	fi
fi

# Format + lint every TypeScript source, then typecheck the monorepo.
# Pass workspace dirs only — Windows rejects literal "*.ts" path args (os error 123).
echo "pre-commit: biome format"
bunx biome format --write --files-ignore-unknown=true \
	backend frontend bot mobile desktop packages scripts

echo "pre-commit: biome check"
bunx biome check --files-ignore-unknown=true \
	backend frontend bot mobile desktop packages scripts

echo "pre-commit: typecheck"
(
	cd backend
	DATABASE_URL="${DATABASE_URL:-file:./ci.db}" DATABASE_PROVIDER="${DATABASE_PROVIDER:-sqlite}" \
		bun run db:generate
)
bun run typecheck

# If format rewrote already-staged files, keep the index in sync.
git update-index --again
