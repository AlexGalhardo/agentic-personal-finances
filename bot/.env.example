# The bot imports prisma/encrypt/decrypt/services from
# @agentic-personal-finances/backend, so it needs the SAME values as
# backend/.env (same database, same encryption key) — copy them below.
# The bot is multi-tenant: each chat links to its own account by logging in
# (e-mail/password in the chat, or through the browser for Google/2FA).
NODE_ENV=development
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:../backend/dev.db
FRONTEND_URL=http://localhost:4001

# same value as BETTER_AUTH_SECRET in backend/.env
BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>

# same value as ENCRYPTION_KEY in backend/.env — required, it decrypts and
# encrypts transactions
ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# --- bot-specific ---

# token from @BotFather
TELEGRAM_BOT_TOKEN=<token-from-botfather>

# --- ops alerts via @galhardoalex/telegram-logger (optional; no-op if unset) ---
# Use a dedicated alerts chat so user chats stay quiet. Falls back to
# TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID when LOGGER_* are empty.
TELEGRAM_LOGGER_BOT_TOKEN=
TELEGRAM_LOGGER_CHAT_ID=
TELEGRAM_CHAT_ID=

# base64 of a bcrypt hash of the personal confirmation password — generate
# with: bun run hash-password "your-password"
# (base64 because bcrypt hashes contain "$", which Bun and Docker Compose
# both try to expand when reading .env)
BOT_PASSWORD_HASH_BASE64=<bcrypt-hash-in-base64>

# consecutive wrong personal-password attempts before a temporary lockout
BOT_MAX_ATTEMPTS=5

# lockout duration in minutes after BOT_MAX_ATTEMPTS
BOT_LOCKOUT_MINUTES=15

# feature flag: require the personal password (BOT_PASSWORD_HASH_BASE64)
# before every data action (expense, income, summary, search, delete, report)
TELEGRAM_BOT_USE_PASSWORD_TO_CONFIRM_ACTIONS=false

# --- PIX payments inside the chat (same values as backend/.env) ---
# false = no paywall at all (no free limit, bot not gated, no checkout)
ENABLE_PAYWALL=true
ENABLE_ABACATEPAY=false
ABACATEPAY_API_KEY=
ABACATEPAY_PIX_TEST_MODE=false
